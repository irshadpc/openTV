<?xml version="1.0" encoding="utf-8"?>
<!-- Root container for the streaming experience. Black background so any
     letterboxing around video blends into the TV bezel. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- The main WebView fills the screen. -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Container that HTML5 full-screen video is attached to. Sits above the
         WebView and is hidden until video goes full screen. -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

    <!-- Thin top progress bar reflecting page load percentage. -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="@color/accent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Center loading spinner shown while a page loads. -->
    <ProgressBar
        android:id="@+id/loadingSpinner"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:indeterminateTint="@color/accent"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- On-screen control bar (always reachable so no hardware MENU key is
         needed). Each button is focusable for D-pad AND clickable by the
         virtual cursor. Bottom-right. -->
    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_control_bar"
        android:padding="8dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:padding="13dp"
            android:src="@drawable/ic_menu"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/settings_title"
            android:focusable="true" />

        <ImageButton
            android:id="@+id/cursorButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:padding="13dp"
            android:src="@drawable/ic_pointer_toggle"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/action_toggle_cursor"
            android:focusable="true" />

        <ImageButton
            android:id="@+id/refreshButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="13dp"
            android:src="@drawable/ic_refresh"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/action_refresh"
            android:focusable="true" />

    </LinearLayout>

    <!-- Virtual D-pad pointer. Sits on top of the WebView; moved with the
         arrows and "clicked" with OK/Center. Hidden until cursor mode is on. -->
    <ImageView
        android:id="@+id/cursorView"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_cursor"
        android:visibility="gone"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Full-screen offline / retry overlay (hidden until connectivity drops). -->
    <LinearLayout
        android:id="@+id/offlineLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/background"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_offline"
            android:contentDescription="@string/offline_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/offline_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/offline_message"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:minWidth="200dp"
            android:padding="16dp"
            android:text="@string/action_retry"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:background="@drawable/focus_ring_button"
            android:focusable="true" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
