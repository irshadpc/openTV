<?xml version="1.0" encoding="utf-8"?>
<!-- Background for focusable controls. Shows a large, high-contrast ring and a
     subtle scale-up feel via stroke + accent fill when focused, so D-pad focus
     is obvious from across the room. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused state: filled accent with a thick ring. -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_dark" />
            <stroke android:width="4dp" android:color="@color/focus_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Pressed state. -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_dark" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Default state: translucent surface. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/text_secondary" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</selector>
