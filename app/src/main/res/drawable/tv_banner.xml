<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV home-screen banner (320x180, 16:9): dark panel, gradient emblem,
     wordmark + tagline. Vector so it stays crisp on 1080p and 4K. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- Background with a subtle vertical gradient. -->
    <path android:pathData="M0,0 h320 v180 h-320 z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="0" android:startY="0" android:endX="0" android:endY="180" android:type="linear">
                <item android:offset="0.0" android:color="#12121C" />
                <item android:offset="1.0" android:color="#0B0B12" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Gradient emblem (rounded square + play). -->
    <path android:pathData="M40,58 h64 a14,14 0 0 1 14,14 v0 a0,0 0 0 1 0,0 v22 a14,14 0 0 1 -14,14 h-64 a14,14 0 0 1 -14,-14 v-22 a14,14 0 0 1 14,-14 z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="26" android:startY="58" android:endX="118" android:endY="122" android:type="linear">
                <item android:offset="0.0" android:color="#00E0A4" />
                <item android:offset="0.55" android:color="#13C7D6" />
                <item android:offset="1.0" android:color="#3B82F6" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:fillColor="#FFFFFF"
        android:pathData="M62,74 L88,89 a2,2 0 0 1 0,3.4 L62,106 a2,2 0 0 1 -3,-1.7 V75.7 a2,2 0 0 1 3,-1.7 z" />

    <!-- Wordmark "OPEN TV" -->
    <path android:fillColor="#FFFFFF" android:pathData="M140,70 h120 v13 h-120 z" />
    <!-- Tagline -->
    <path android:fillColor="#3BE7C4" android:pathData="M140,92 h84 v7 h-84 z" />
    <path android:fillColor="#5A5C70" android:pathData="M140,106 h120 v5 h-120 z" />
</vector>
