<?xml version="1.0" encoding="utf-8"?>
<!-- Splash / app background: deep dark with a soft brand-coloured glow top area. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#12121C"
                android:endColor="#0B0B12"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="640"
                android:centerX="0.5"
                android:centerY="0.42"
                android:startColor="#2600E0A4"
                android:endColor="#000B0B12" />
        </shape>
    </item>
</layer-list>
