<?xml version="1.0" encoding="utf-8"?>
<!-- "Open TV" emblem: a glossy rounded-square with a brand gradient and a white
     play triangle. Modern, fun, instantly readable as a streaming app. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rounded-square body with a diagonal brand gradient. -->
    <path android:pathData="M30,14 h48 a16,16 0 0 1 16,16 v48 a16,16 0 0 1 -16,16 h-48 a16,16 0 0 1 -16,-16 v-48 a16,16 0 0 1 16,-16 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="14" android:startY="14"
                android:endX="94" android:endY="94"
                android:type="linear">
                <item android:offset="0.0" android:color="#00E0A4" />
                <item android:offset="0.55" android:color="#13C7D6" />
                <item android:offset="1.0" android:color="#3B82F6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft top highlight for a glossy feel. -->
    <path
        android:pathData="M30,14 h48 a16,16 0 0 1 16,16 v10 H14 v-10 a16,16 0 0 1 16,-16 z"
        android:fillAlpha="0.12"
        android:fillColor="#FFFFFF" />

    <!-- White play triangle (rounded). -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,38 L74,54 a2,2 0 0 1 0,3.5 L44,73 a2,2 0 0 1 -3,-1.7 V39.7 a2,2 0 0 1 3,-1.7 z" />
</vector>
