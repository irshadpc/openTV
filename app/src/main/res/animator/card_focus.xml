<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle zoom when a focusable card gains focus (TV "lift" effect). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.035"
                android:duration="150" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.035"
                android:duration="150" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0"
                android:duration="150" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0"
                android:duration="150" android:valueType="floatType" />
        </set>
    </item>
</selector>
